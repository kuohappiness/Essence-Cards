{
  "name": "essence-cards",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "install-vault": "node tools/install-vault.mjs",
    "backup": "node tools/backup.ts",
    "restore": "node tools/restore.ts",
    "compare-versions": "node tools/compare-versions.ts",
    "update-vault": "node tools/update-vault.ts",
    "locate": "node tools/locate.ts",
    "lint": "eslint src tools tests",
    "knip": "node tools/knip.mjs",
    "secretlint": "node tools/secretlint.mjs",
    "skills": "node tools/check-skill-mirror.ts",
    "docs": "node tools/check-docs.ts",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run secretlint && npm run skills && npm run docs && npm test",
    "preprepare": "node -e \"const fs=require('node:fs');for(const n of fs.readdirSync('.githooks')){const p='.githooks/'+n;fs.writeFileSync(p,fs.readFileSync(p,'utf8').replaceAll('\\r\\n','\\n'));}\"",
    "prepare": "git config core.hooksPath .githooks",
    "bench": "node tools/bench-study.ts",
    "export-compare": "node tools/export-compare.ts",
    "progress-board": "node tools/progress-board.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "fflate": "0.8.3",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "5.4.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.11",
    "eslint": "^10.13.0",
    "github-slugger": "^2.0.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.42.1",
    "markdown-it": "^14.3.3",
    "obsidian": "^1.8.7",
    "secretlint": "^13.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
