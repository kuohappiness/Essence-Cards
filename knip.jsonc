{
  // tools/check-skill-mirror.ts 由 skills npm script 自動列為入口。
  "entry": ["src/main.ts", "tools/*.mjs", "tests/**/*.test.ts"],
  "project": ["src/**/*.{ts,tsx}", "tools/*.{ts,mjs}", "tools/compare/*.ts", "tests/**/*.ts"],
  // React、react-dom、Motion 由 W6 的畫面（src/ui/）使用。
  // secretlint 在 npm script 的 node -e 載入；recommend preset 由 .secretlintrc.json 動態載入。
  // @emnapi/core、@emnapi/runtime 是 Linux 上 knip 的 wasm 解析器需要的 peer；Windows 的 npm install 會把它們從 lock 刪掉，讓 CI 的 npm ci 失敗，所以明列為開發相依。
  // electron 由 Obsidian 電腦版在執行時提供（D-148，只有 src/desktop/ 用），不裝進 node_modules。
  "ignoreDependencies": ["@emnapi/core", "@emnapi/runtime", "secretlint", "@secretlint/secretlint-rule-preset-recommend", "electron"]
}
