#!/bin/sh
set -eu

if ! git diff --cached --name-only --diff-filter=ACMRD | grep -Eq '^(src/|tests/|tools/|\.claude/skills/|\.agents/skills/|package[^/]*\.json$|tsconfig\.json$|manifest\.json$|eslint\.config\.js$|knip\.[^/]+$|\.secretlint[^/]*$|\.githooks/|\.github/workflows/check\.yml$)'; then
  exit 0
fi
if [ ! -d node_modules ]; then
  echo '先執行 npm install' >&2
  exit 1
fi
npm run check
